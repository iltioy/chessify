# Ключи и подключения проще вписать в веб-интерфейсе (кнопка «Настройки») — тогда этот файл не нужен.

# Порт веб-интерфейса на этом компьютере (по умолчанию 37415): http://localhost:37415
CHESSIFY_PORT=
# Этот файл — шаблон: настоящие ключи держите в .env (он не попадает в git). Заданное в интерфейсе важнее.

# Свой сервер (профиль custom): любой OpenAI-совместимый API — vLLM, SGLang, Ollama, LM Studio, прокси.
# Список моделей на сервере: uv run chessify llm-check --provider custom
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# DeepSeek (профиль deepseek): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google Gemini (профиль gemini, бесплатный тариф): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI (профиль openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenRouter (профиль openrouter): модель в формате компания/модель
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Anthropic API (профиль anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Профиль по умолчанию: custom, deepseek, gemini, openai, openrouter, anthropic или claude
CHESSIFY_DEFAULT_PROFILE=

# Hugging Face: токен для модели pyannote/speaker-diarization-community-1 (бесплатно, нужно принять условия модели)
HF_TOKEN=
